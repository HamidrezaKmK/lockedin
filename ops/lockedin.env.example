# Copy to ops/lockedin.env or another private env file used by systemd.

LOCKEDIN_PORT=8080
LOCKEDIN_LOCAL_URL=http://127.0.0.1:8080/
LOCKEDIN_PUBLIC_URL=
LOCKEDIN_NEWS_ENABLED=0
# LOCKEDIN_INSECURE_COOKIE=1  # only for plain HTTP local/LAN deployments

# Set this only when you have a tunnel/domain and want public URL monitoring.
# LOCKEDIN_PUBLIC_URL=https://yourdomain.example/

# Optional monitor checks.
# LOCKEDIN_SLACKBOT_ENABLED=0
# LOCKEDIN_OLLAMA_ENABLED=1

# Optional model/backend settings.
# OLLAMA_URL=http://127.0.0.1:11434/
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# QWEN_MODEL=qwen2.5:7b-instruct

# Optional monitor paths.
# LOCKEDIN_MONITOR_LOG=/path/to/repo/ops/monitor.log
# LOCKEDIN_MONITOR_STATE=/path/to/repo/ops/.state

# Optional Slack bot settings.
# SLACK_BOT_TOKEN=
# SLACK_APP_TOKEN=
# LOCKEDIN_URL=https://yourdomain.example/
