# A second LockedIn beside production, for developing the agent queue. No secrets here.
# Run it as the `lockedin-dev-serve.service` user unit (see docs in the plan), never through
# ops/install-systemd-user.sh, which would rewrite the production units.
LOCKEDIN_PORT=8790
LOCKEDIN_HOME=/home/hamid/lockedin-dev
LOCKEDIN_INSECURE_COOKIE=1
LOCKEDIN_LOCAL_URL=http://localhost:8790/
LOCKEDIN_PUBLIC_URL=
LOCKEDIN_SLACKBOT_ENABLED=0
# Names this instance's installed client so its setup link can never replace the production
# lockedin-scientist command on a machine that also syncs a production bubble.
LOCKEDIN_CLIENT_NAME=lockedin-scientist-dev
