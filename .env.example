# Copy to `.env` for local development secrets. Do not commit real values.

# DEV mode credentials.
# `uv run lockedin devmode` reads these; an agent uses them to scope itself to
# the legacy local-development workspace for that account.
DEV_USERNAME=your-username
DEV_PASSWORD=your-password

# Server behavior.
# LOCKEDIN_HOME=/absolute/path/for/data-root
# LOCKEDIN_CORS_ORIGINS=
# LOCKEDIN_INSECURE_COOKIE=1  # only for plain HTTP local/LAN deployments

# Slack bot.
# SLACK_BOT_TOKEN=
# SLACK_APP_TOKEN=
# LOCKEDIN_URL=https://yourdomain.example/
# SLACKBOT_INVITE_LINK=https://join.slack.com/t/your-workspace/shared_invite/...

# Local Qwen via Ollama.
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# QWEN_MODEL=qwen2.5:7b-instruct

# Optional API provider keys are stored per user from the app UI.
